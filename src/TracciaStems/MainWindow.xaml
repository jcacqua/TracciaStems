<Window x:Class="TracciaStems.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TracciaStems.UI"
        Title="TracciaStems" Width="1400" Height="860" MinWidth="1000" MinHeight="500"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Icon="app.ico"
        Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing" Closed="Window_Closed">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ui:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    </Window.Resources>

    <DockPanel>

        <!-- ===== Barre d'outils ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="False">
                <DockPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </DockPanel.Resources>
                <ui:AnimatedLogo DockPanel.Dock="Left" Height="68" Width="78" Margin="0,-6,16,-6" ToolTip="TracciaStems"/>
                <Button DockPanel.Dock="Left" Content="＋ Ajouter des stems…" Click="AddStems_Click" IsEnabled="{Binding IsIdle}" ToolTip="WAV, MP3, FLAC, AIFF… (Ctrl+O)"/>
                <Button DockPanel.Dock="Left" Content="Nouveau" Click="NewProject_Click" IsEnabled="{Binding IsIdle}"/>
                <Button DockPanel.Dock="Left" Content="Ouvrir un projet…" Click="OpenProject_Click" IsEnabled="{Binding IsIdle}"/>
                <Button DockPanel.Dock="Left" Content="Enregistrer" Click="SaveProject_Click" IsEnabled="{Binding IsIdle}" ToolTip="Ctrl+S"/>
                <Button DockPanel.Dock="Left" Content="Enregistrer sous…" Click="SaveProjectAs_Click" IsEnabled="{Binding IsIdle}"/>
                <Button DockPanel.Dock="Right" Content="⇩ Exporter le mix (WAV / MP3)…" Click="Export_Click" IsEnabled="{Binding IsIdle}"
                        Background="#1F4E74" BorderBrush="{StaticResource Accent}" Margin="0"/>
            </DockPanel>
        </Border>

        <!-- ===== Transport + master ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- transport -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <Button Content="⏮" Click="Rewind_Click" ToolTip="Retour au début (Origine)" FontSize="14" Width="38"/>
                    <Button Content="{Binding PlayGlyph}" Click="PlayPause_Click" ToolTip="Lecture / pause (Espace)" FontSize="14" Width="46"
                            Background="#24553A" BorderBrush="{StaticResource Green}"/>
                    <Button Content="■" Click="Stop_Click" ToolTip="Stop (retour au début)" FontSize="14" Width="38"/>
                    <ToggleButton Style="{StaticResource Toggle}" Tag="{StaticResource Red}" IsChecked="{Binding IsRecording, Mode=OneWay}"
                                  Click="Record_Click" Padding="10,4" FontSize="13" Margin="4,0,8,0"
                                  ToolTip="Enregistrer le mix en direct (R) : tout ce que vous entendez, mouvements de faders compris">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" Foreground="{StaticResource Red}" Margin="0,0,5,0"/>
                            <TextBlock Text="REC" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </StackPanel>
                    </ToggleButton>
                    <Border Background="#101216" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="17"/>
                            <TextBlock Text="{Binding RecordText}" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Red}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- tempo + master -->
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                    <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                        <ComboBox ItemsSource="{Binding LoopBarOptions}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                  SelectedValue="{Binding GlobalLoopBars}" Width="70" Margin="0,0,4,0"
                                  ToolTip="Longueur de boucle pour « Tout boucler ici »"/>
                        <Button Content="⟳ Tout boucler ici" Click="LoopAllHere_Click" Background="#5A3A10" BorderBrush="{StaticResource Orange}"
                                ToolTip="Boucle tous les stems à la position de lecture, sur le nombre de mesures choisi (touche L). Recliquer pour reprendre le morceau."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                        <TextBlock Text="BPM" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding BpmText, UpdateSourceTrigger=LostFocus}" Width="56" KeyDown="TextBox_KeyDown" FontFamily="Consolas"
                                 ToolTip="Tempo du projet (grille, longueur des boucles en mesures)"/>
                        <Button Style="{StaticResource SmallButton}" Content="÷2" Click="BpmHalf_Click" Margin="4,0,2,0"/>
                        <Button Style="{StaticResource SmallButton}" Content="×2" Click="BpmDouble_Click"/>
                        <Button Style="{StaticResource SmallButton}" Content="Détecter" Click="DetectMixBpm_Click" IsEnabled="{Binding IsIdle}"
                                ToolTip="Détecte le tempo et les mesures (position du 1er temps) sur les stems, puis recale les boucles"/>
                        <Button Style="{StaticResource SmallButton}" Content="◀" Click="GridLeft_Click" Margin="4,0,2,0"
                                ToolTip="{Binding GridText}"/>
                        <TextBlock Text="1er temps" Style="{StaticResource Lbl}" ToolTip="{Binding GridText}" Margin="0,0,2,0"/>
                        <Button Style="{StaticResource SmallButton}" Content="▶" Click="GridRight_Click"
                                ToolTip="Décaler la grille (et les boucles calées) d'un temps"/>
                        <TextBlock Text="Temps/mes." Style="{StaticResource Lbl}" Margin="6,0,4,0"/>
                        <ComboBox Width="44" SelectedItem="{Binding BeatsPerBar}" x:Name="BeatsCombo"/>
                        <CheckBox Content="Aimanter" IsChecked="{Binding SnapToGrid}" Margin="8,0,0,0"
                                  ToolTip="Aligne les boucles dessinées à la souris sur les temps"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                        <TextBlock Text="Reverb  taille" Style="{StaticResource Lbl}"/>
                        <Slider Minimum="0" Maximum="1" Value="{Binding ReverbRoom}" Tag="0.7" MouseDoubleClick="Slider_ResetOnDoubleClick" Width="60"/>
                        <TextBlock Text="amorti" Style="{StaticResource Lbl}" Margin="8,0,4,0"/>
                        <Slider Minimum="0" Maximum="1" Value="{Binding ReverbDamp}" Tag="0.45" MouseDoubleClick="Slider_ResetOnDoubleClick" Width="60"/>
                        <TextBlock Text="retour" Style="{StaticResource Lbl}" Margin="8,0,4,0"/>
                        <Slider Minimum="-30" Maximum="6" Value="{Binding ReverbReturnDb}" Tag="0" MouseDoubleClick="Slider_ResetOnDoubleClick" Width="60"/>
                        <TextBlock Text="{Binding ReverbReturnDb, StringFormat={}{0:+0.0;-0.0;0} dB}" Style="{StaticResource Val}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                        <TextBlock Text="Durée (s)" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding DurationOverrideSec, UpdateSourceTrigger=LostFocus}" Width="52" KeyDown="TextBox_KeyDown"
                                 ToolTip="Durée du morceau en secondes. 0 = automatique (stem le plus long). Utile pour prolonger des boucles."/>
                        <TextBlock Text="{Binding FormatText}" Style="{StaticResource Lbl}" Margin="10,0,0,0"/>
                    </StackPanel>
                </WrapPanel>

                <!-- master -->
                <Border Grid.Column="2" Background="{StaticResource PanelLight}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MASTER" FontWeight="Bold" FontSize="11" Margin="0,0,10,0"/>
                        <Slider Minimum="-60" Maximum="12" Value="{Binding MasterVolumeDb}" Tag="0" MouseDoubleClick="Slider_ResetOnDoubleClick" Width="120"/>
                        <TextBlock Text="{Binding MasterVolumeText}" Style="{StaticResource Val}" MinWidth="52"/>
                        <CheckBox Content="Limiteur" IsChecked="{Binding LimiterEnabled}" ToolTip="Limiteur de sortie à -0,3 dBFS (évite toute saturation)"/>
                        <ui:LevelMeter LevelL="{Binding MeterL}" LevelR="{Binding MeterR}" Width="14" Height="34" Margin="4,0,4,0"/>
                        <Border Width="10" Height="10" CornerRadius="5" ToolTip="Saturation (cliquer pour réinitialiser)" MouseLeftButtonDown="Clip_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#3A1A1A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Clip}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Red}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Barre d'état ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="220" Height="10" Minimum="0" Maximum="1" Value="{Binding Progress}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource Accent}" Background="#14171C" BorderThickness="0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Annuler" Click="Cancel_Click"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextDim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ===== Pistes ===== -->
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,6">
                <ItemsControl ItemsSource="{Binding Tracks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ui:TrackViewModel}">
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6"
                                    Margin="0,0,0,6" Height="168">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="610"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- liseré couleur -->
                                    <Border Grid.Column="0" CornerRadius="6,0,0,6" Background="{Binding ColorHex}"/>

                                    <!-- réglages -->
                                    <StackPanel Grid.Column="1" Margin="8,6,4,6">

                                        <!-- ligne 1 : nom, M/S, BPM, supprimer -->
                                        <DockPanel Margin="0,0,0,5">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="✕" Click="RemoveTrack_Click"
                                                    ToolTip="Retirer ce stem" Margin="4,0,0,0"/>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="→ tempo projet" Click="UseTrackBpm_Click"
                                                    Visibility="{Binding HasDetectedBpm, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Utiliser ce tempo comme tempo du projet"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DetectedBpmText}" Style="{StaticResource Val}" Foreground="{StaticResource Yellow}" Margin="4,0,6,0" MinWidth="0"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding GainReductionText}" Style="{StaticResource Val}" Foreground="{StaticResource Orange}" MinWidth="0" Margin="0,0,10,0"
                                                       ToolTip="Réduction de gain du compresseur (dB)"/>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="BPM ?" Click="DetectTrackBpm_Click"
                                                    ToolTip="Détecter le tempo de ce stem"/>
                                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Toggle}" Tag="{StaticResource Red}" Content="M" Width="26" IsChecked="{Binding Mute}" ToolTip="Muet"/>
                                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Toggle}" Tag="{StaticResource Yellow}" Content="S" Width="26" IsChecked="{Binding Solo}" ToolTip="Solo (Ctrl+clic : solo exclusif)" PreviewMouseLeftButtonDown="Solo_PreviewMouseDown"/>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontWeight="SemiBold" FontSize="13" Margin="4,0,8,0"
                                                     Background="Transparent" BorderThickness="0" KeyDown="TextBox_KeyDown" ToolTip="{Binding FileInfo}"/>
                                        </DockPanel>

                                        <!-- ligne 2 : volume, pan, reverb -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="Vol" Style="{StaticResource Lbl}" Width="30"/>
                                            <Slider Minimum="-60" Maximum="12" Value="{Binding VolumeDb}" Tag="0" MouseDoubleClick="Slider_ResetOnDoubleClick" Width="130" SmallChange="0.5" LargeChange="3"/>
                                            <TextBlock Text="{Binding VolumeText}" Style="{StaticResource Val}" MinWidth="52"/>
                                            <TextBlock Text="Pan" Style="{StaticResource Lbl}"/>
                                            <Slider Minimum="-1" Maximum="1" Value="{Binding Pan}" Tag="0" MouseDoubleClick="Slider_ResetOnDoubleClick" Width="80"/>
                                            <TextBlock Text="{Binding PanText}" Style="{StaticResource Val}" MinWidth="30"/>
                                            <TextBlock Text="Reverb" Style="{StaticResource Lbl}"/>
                                            <Slider Minimum="0" Maximum="1" Value="{Binding ReverbSend}" Tag="0" MouseDoubleClick="Slider_ResetOnDoubleClick" Width="80"/>
                                            <TextBlock Text="{Binding ReverbText}" Style="{StaticResource Val}" MinWidth="30"/>
                                        </StackPanel>

                                        <!-- ligne 3 : EQ -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="EQ" Style="{StaticResource Lbl}" Width="30"/>
                                            <TextBlock Text="Grave" Style="{StaticResource Lbl}"/>
                                            <Slider Minimum="-15" Maximum="15" Value="{Binding EqLow}" Tag="0" MouseDoubleClick="Slider_ResetOnDoubleClick" ToolTip="Shelf 200 Hz — double-clic : 0"/>
                                            <TextBlock Text="{Binding EqLow, StringFormat={}{0:+0.0;-0.0;0}}" Style="{StaticResource Val}" MinWidth="30"/>
                                            <TextBlock Text="Médium" Style="{StaticResource Lbl}"/>
                                            <Slider Minimum="-15" Maximum="15" Value="{Binding EqMid}" Tag="0" MouseDoubleClick="Slider_ResetOnDoubleClick" ToolTip="Cloche 1 kHz — double-clic : 0"/>
                                            <TextBlock Text="{Binding EqMid, StringFormat={}{0:+0.0;-0.0;0}}" Style="{StaticResource Val}" MinWidth="30"/>
                                            <TextBlock Text="Aigu" Style="{StaticResource Lbl}"/>
                                            <Slider Minimum="-15" Maximum="15" Value="{Binding EqHigh}" Tag="0" MouseDoubleClick="Slider_ResetOnDoubleClick" ToolTip="Shelf 5 kHz — double-clic : 0"/>
                                            <TextBlock Text="{Binding EqHigh, StringFormat={}{0:+0.0;-0.0;0} dB}" Style="{StaticResource Val}"/>
                                        </StackPanel>

                                        <!-- ligne 4 : compresseur -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <ToggleButton Style="{StaticResource Toggle}" Tag="{StaticResource Accent}" Content="Comp" IsChecked="{Binding CompEnabled}" Width="46" Margin="0,0,6,0"/>
                                            <TextBlock Text="Seuil" Style="{StaticResource Lbl}"/>
                                            <Slider Minimum="-50" Maximum="0" Value="{Binding CompThreshold}" Tag="-18" MouseDoubleClick="Slider_ResetOnDoubleClick" Width="44"/>
                                            <TextBlock Text="{Binding CompThreshold, StringFormat={}{0:0}}" Style="{StaticResource Val}" MinWidth="22" Margin="2,0,5,0"/>
                                            <TextBlock Text="Ratio" Style="{StaticResource Lbl}"/>
                                            <Slider Minimum="1" Maximum="20" Value="{Binding CompRatio}" Tag="4" MouseDoubleClick="Slider_ResetOnDoubleClick" Width="44"/>
                                            <TextBlock Text="{Binding CompRatio, StringFormat={}{0:0.#}:1}" Style="{StaticResource Val}" MinWidth="34" Margin="2,0,5,0"/>
                                            <TextBlock Text="Att" Style="{StaticResource Lbl}"/>
                                            <Slider Minimum="0.1" Maximum="100" Value="{Binding CompAttack}" Tag="10" MouseDoubleClick="Slider_ResetOnDoubleClick" Width="40"/>
                                            <TextBlock Text="{Binding CompAttack, StringFormat={}{0:0.#}ms}" Style="{StaticResource Val}" MinWidth="36" Margin="2,0,5,0"/>
                                            <TextBlock Text="Rel" Style="{StaticResource Lbl}"/>
                                            <Slider Minimum="10" Maximum="1000" Value="{Binding CompRelease}" Tag="120" MouseDoubleClick="Slider_ResetOnDoubleClick" Width="40"/>
                                            <TextBlock Text="{Binding CompRelease, StringFormat={}{0:0}ms}" Style="{StaticResource Val}" MinWidth="40" Margin="2,0,5,0"/>
                                            <TextBlock Text="Gain" Style="{StaticResource Lbl}"/>
                                            <Slider Minimum="0" Maximum="24" Value="{Binding CompMakeup}" Tag="0" MouseDoubleClick="Slider_ResetOnDoubleClick" Width="40"/>
                                            <TextBlock Text="{Binding CompMakeup, StringFormat={}+{0:0.#}}" Style="{StaticResource Val}" MinWidth="28" Margin="3,0,4,0"/>
                                        </StackPanel>

                                        <!-- ligne 5 : répétition du fichier OU boucle de zone -->
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton Style="{StaticResource Toggle}" Tag="{StaticResource Orange}" Content="∞ Répéter" IsChecked="{Binding RepeatWholeFile}"
                                                          Click="RepeatToggle_Click" Margin="0,0,8,0"
                                                          ToolTip="Répète le fichier entier sur toute la longueur du morceau (stem court, boucle de batterie…)."/>

                                            <!-- boucle de zone (stem normal) -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding RepeatWholeFile, Converter={StaticResource InvBoolToVis}}">
                                                <ComboBox ItemsSource="{Binding LoopBarOptions}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                                          SelectedValue="{Binding LoopBars}" Width="66" Margin="0,0,4,0"
                                                          ToolTip="Longueur de la boucle (au tempo du projet)"/>
                                                <ToggleButton Style="{StaticResource Toggle}" Tag="{StaticResource Orange}" Content="⟳ Boucler ici" IsChecked="{Binding LoopEnabled}" Margin="0,0,8,0"
                                                              Click="LoopToggle_Click"
                                                              ToolTip="Boucle ce stem à partir de la position de lecture actuelle (aimantée au temps), sur la longueur choisie. Recliquer pour reprendre le morceau. Maj + glisser sur la forme d'onde pour dessiner une boucle."/>
                                                <TextBlock Text="Début" Style="{StaticResource Lbl}"/>
                                                <TextBox Text="{Binding LoopStartSec, StringFormat={}{0:0.000}, UpdateSourceTrigger=LostFocus}" Width="54" KeyDown="TextBox_KeyDown" FontFamily="Consolas" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="Fin" Style="{StaticResource Lbl}"/>
                                                <TextBox Text="{Binding LoopEndSec, StringFormat={}{0:0.000}, UpdateSourceTrigger=LostFocus}" Width="54" KeyDown="TextBox_KeyDown" FontFamily="Consolas" FontSize="11"/>
                                                <TextBlock Text="{Binding LoopInfo}" Style="{StaticResource Lbl}" Margin="6,0,0,0"/>
                                            </StackPanel>

                                            <!-- stem répété : calage sur les mesures -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding RepeatWholeFile, Converter={StaticResource BoolToVis}}">
                                                <Button Style="{StaticResource SmallButton}" Content="🎯 Caler sur les mesures" Click="AlignTrack_Click"
                                                        ToolTip="Détecte les mesures du morceau et de la boucle, ajuste la durée de la boucle au tempo (sans changer la hauteur) et place son 1er temps sur les 1ers temps du morceau."/>
                                                <Button Style="{StaticResource SmallButton}" Content="◀" Click="NudgeRepeatLeft_Click" ToolTip="Décaler la boucle d'un temps plus tôt"/>
                                                <Button Style="{StaticResource SmallButton}" Content="▶" Click="NudgeRepeatRight_Click" ToolTip="Décaler la boucle d'un temps plus tard"/>
                                                <Button Style="{StaticResource SmallButton}" Content="↺" Click="ClearAlign_Click" ToolTip="Annuler le calage (fichier d'origine, départ au début du morceau)"
                                                        Visibility="{Binding IsAligned, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding RepeatInfo}" Style="{StaticResource Lbl}" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- vu-mètre -->
                                    <ui:LevelMeter Grid.Column="2" LevelL="{Binding MeterL}" LevelR="{Binding MeterR}" Margin="3,8"/>

                                    <!-- forme d'onde -->
                                    <Border Grid.Column="3" Margin="2,6,6,6" CornerRadius="4" ClipToBounds="True">
                                        <ui:WaveformView Peaks="{Binding Peaks}" StemFrames="{Binding StemFrames}" SampleRate="{Binding SampleRate}"
                                                         TimelineFrames="{Binding TimelineFrames}" PositionFrames="{Binding PositionFrames}"
                                                         LoopEnabled="{Binding DisplayLoopEnabled}" LoopStartSec="{Binding DisplayLoopStartSec}" LoopEndSec="{Binding DisplayLoopEndSec}"
                                                         RepeatMode="{Binding RepeatWholeFile}" RepeatPhaseSec="{Binding RepeatPhaseSec}"
                                                         GridOffsetSec="{Binding DataContext.GridOffsetSec, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         IsDimmed="{Binding IsDimmed}" WaveColor="{Binding ColorHex}"
                                                         Bpm="{Binding DataContext.Bpm, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         BeatsPerBar="{Binding DataContext.BeatsPerBar, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         SeekRequested="Waveform_SeekRequested" LoopSelected="Waveform_LoopSelected"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- écran d'accueil -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasTracks, Converter={StaticResource InvBoolToVis}}">
                <ui:AnimatedLogo Height="320" Width="360" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Glissez vos stems ici" FontSize="24" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                <TextBlock Text="WAV ou MP3 — batterie, basse, voix, instruments…" FontSize="14" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,6,0,16"/>
                <Button Content="＋ Ajouter des stems…" Click="AddStems_Click" HorizontalAlignment="Center" Padding="16,8" FontSize="14"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
